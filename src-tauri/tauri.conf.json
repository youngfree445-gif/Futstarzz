{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fut Starzz 2026",
  "version": "1.0.0",
  "identifier": "com.futstarzz.juego",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Fut Starzz 2026",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "copyright": "Fut Starzz 2026",
    "shortDescription": "Simulador de carrera futbolistica",
    "longDescription": "De las inferiores a la seleccion: liga, copas, mercado y vida fuera de la cancha."
  }
}

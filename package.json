{
  "name": "Fut Starzz 2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "validar:calendario": "esbuild scripts/validar_calendario.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/validar_calendario.cjs --loader:.png=dataurl --loader:.jpg=dataurl --loader:.jpeg=dataurl --loader:.svg=dataurl --loader:.webp=dataurl --log-level=error && node node_modules/.cache/validar_calendario.cjs",
    "build:netlify": "cross-env GH_PAGES= CAPACITOR= vite build",
    "build:ghpages": "cross-env GH_PAGES=true vite build",
    "deploy": "npm run build:ghpages && gh-pages -d dist-ghpages",
    "build:capacitor": "cross-env CAPACITOR=true vite build",
    "cap:sync": "npm run build:capacitor && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios",
    "validar:copas": "esbuild scripts/validar_copas.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/validar_copas.cjs --loader:.png=dataurl --loader:.jpg=dataurl --loader:.jpeg=dataurl --loader:.svg=dataurl --loader:.webp=dataurl --log-level=error && node node_modules/.cache/validar_copas.cjs",
    "validar:uncalendario": "esbuild scripts/validar_un_calendario.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/validar_un_calendario.cjs --loader:.png=dataurl --loader:.jpg=dataurl --loader:.jpeg=dataurl --loader:.svg=dataurl --loader:.webp=dataurl --log-level=error && node node_modules/.cache/validar_un_calendario.cjs",
    "validar:titulos": "esbuild scripts/validar_titulos.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/validar_titulos.cjs --loader:.png=dataurl --loader:.jpg=dataurl --loader:.jpeg=dataurl --loader:.svg=dataurl --loader:.webp=dataurl --log-level=error && node node_modules/.cache/validar_titulos.cjs",
    "validar:playoffs": "esbuild scripts/validar_playoffs.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/validar_playoffs.cjs --loader:.png=dataurl --loader:.jpg=dataurl --loader:.jpeg=dataurl --loader:.svg=dataurl --loader:.webp=dataurl --log-level=error && node node_modules/.cache/validar_playoffs.cjs",
    "validar:tarjetas": "node scripts/validar_tarjetas.cjs",
    "validar:eliminatorias": "esbuild scripts/validar_eliminatorias.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/validar_eliminatorias.cjs --loader:.png=dataurl --loader:.jpg=dataurl --loader:.jpeg=dataurl --loader:.svg=dataurl --loader:.webp=dataurl --log-level=error && node node_modules/.cache/validar_eliminatorias.cjs",
    "validar:partida": "esbuild scripts/validar_partida_archivo.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/validar_partida.mjs --log-level=error && node node_modules/.cache/validar_partida.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.0.0"
  }
}
